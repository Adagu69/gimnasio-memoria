{
  "name": "gimnasio-memoria",
  "version": "3.0.0",
  "description": "Gimnasio de memoria en Pixel-3D (Three.js + Matter.js): prueba de nivel, sesión diaria e índice de memoria con cuatro ejercicios adaptativos (Pares, Secuencia, N-Back y Palacio de la memoria).",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node tools/dev.mjs",
    "build": "node tools/build.mjs",
    "test": "node tools/test.mjs",
    "test:unit": "node --test --experimental-test-coverage \"tools/unit/*.test.mjs\"",
    "capturas": "node tools/capturas.mjs",
    "video": "node tools/video.mjs",
    "informe": "node tools/informe.mjs"
  },
  "devDependencies": {
    "@fontsource/pixelify-sans": "5.3.0",
    "docx": "^9.0.0",
    "esbuild": "^0.24.2",
    "playwright": "^1.56.0"
  },
  "license": "MIT",
  "dependencies": {
    "matter-js": "0.20.0",
    "three": "0.187.0"
  }
}
